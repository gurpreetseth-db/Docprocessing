          },
          {
            "expr": "client_last_name",
            "name": "client_last_name"
          },
          {
            "expr": "gender",
            "name": "gender"
          },
          {
            "expr": "date_of_birth",
            "name": "date_of_birth"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "vulnerability_tier",
            "name": "vulnerability_tier"
          },
          {
            "expr": "first_referral_date",
            "name": "first_referral_date"
          },
          {
            "expr": "latest_service_start_date",
            "name": "latest_service_start_date"
          }
        ],
        "measures": [
          {
            "expr": "COUNT(nhi_number)",
            "name": "total_clients"
          },
          {
            "expr": "AVG(plan_count)",
            "name": "avg_plan_count"
          }
        ],
        "source": "docprocessing.docprocess_gold.dim_client",
        "version": "1.1"
      }
    },
    {
      "name": "fact_service_plan",
      "displayName": "Service Plan Fact",
      "catalog": "docprocessing",
      "config": {
        "dimensions": [
          {
            "expr": "plan_id",
            "name": "plan_id"
          },
          {
            "expr": "nhi_number",
            "name": "nhi_number"
          },
          {
            "expr": "care_coordinator",
            "name": "care_coordinator"
          },
          {
            "expr": "funder",
            "name": "funder"
          },
          {
            "expr": "contract_type",
            "name": "contract_type"
          },
          {
            "expr": "package_of_care",
            "name": "package_of_care"
          },
          {
            "expr": "vulnerability_tier",
            "name": "vulnerability_tier"
          },
          {
            "expr": "referral_date",
            "name": "referral_date"
          },
          {
            "expr": "service_start_date",
            "name": "service_start_date"
          },
          {
            "expr": "review_frequency",
            "name": "review_frequency"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "submitter_email",
            "name": "submitter_email"
          }
        ],
        "measures": [
          {
            "expr": "COUNT(plan_id)",
            "name": "total_plans"
          },
          {
            "expr": "AVG(days_referral_to_start)",
            "name": "avg_days_referral_to_start"
          },
          {
            "expr": "SUM(weekly_care_hours)",
            "name": "total_weekly_care_hours"
          }
        ],
        "source": "docprocessing.docprocess_gold.fact_service_plan",
        "version": "1.1"
      }
    },
    {
      "name": "fact_risk_profile",
      "displayName": "Risk Profile",
      "config": {
        "dimensions": [
          {
            "expr": "nhi_number",
            "name": "nhi_number"
          },
          {
            "expr": "risk_flag",
            "name": "risk_flag"
          },
          {
            "expr": "vulnerability_tier",
            "name": "vulnerability_tier"
          },
          {
            "expr": "region",
            "name": "region"
          }
        ],
        "measures": [
          {
            "expr": "SUM(plan_count)",
            "name": "total_plan_count"
          },
          {
            "expr": "COUNT_IF(has_incomplete_handling_plan = true)",
            "name": "incomplete_handling_plans"
          }
        ],
        "source": "docprocessing.docprocess_gold.fact_risk_profile",
        "version": "1.1"
      }
    },
    {
