          },
          {
            "expr": "funder",
            "name": "funder"
          }
        ],
        "measures": [
          {
            "expr": "SUM(plans_referred)",
            "name": "total_plans_referred"
          },
          {
            "expr": "SUM(plans_started)",
            "name": "total_plans_started"
          },
          {
            "expr": "AVG(avg_days_referral_to_start)",
            "name": "avg_days_referral_to_start"
          },
          {
            "expr": "AVG(avg_weekly_hours)",
            "name": "avg_weekly_hours"
          },
          {
            "expr": "SUM(total_weekly_hours)",
            "name": "total_weekly_hours"
          }
        ],
        "source": "docprocessing.docprocess_gold.agg_intake_funnel",
        "version": "1.1"
      }
    },
    {
      "name": "fact_service_demand",
