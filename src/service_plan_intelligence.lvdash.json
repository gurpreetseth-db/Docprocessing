    {
      "name": "dim_client",
      "displayName": "Client Dimension",
      "catalog": "docprocessing",
      "config": {
        "dimensions": [
          {
            "expr": "nhi_number",
            "name": "nhi_number"
          },
          {
            "expr": "client_first_name",
